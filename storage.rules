rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/figures/{figureId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || (request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
